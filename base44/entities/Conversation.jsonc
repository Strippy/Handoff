{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participant_key": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "listing_id": {
      "type": "string"
    },
    "listing_title": {
      "type": "string"
    },
    "listing_cover": {
      "type": "string"
    },
    "last_message": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string"
    },
    "last_sender_id": {
      "type": "string"
    },
    "participant_a": {
      "type": "string",
      "description": "First participant user id (for RLS)"
    },
    "participant_b": {
      "type": "string",
      "description": "Second participant user id (for RLS)"
    }
  },
  "required": [
    "participant_key"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.participant_a": "{{user.id}}"
        },
        {
          "data.participant_b": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.participant_a": "{{user.id}}"
        },
        {
          "data.participant_b": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

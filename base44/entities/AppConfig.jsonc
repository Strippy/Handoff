{
  "description": "Server-only app settings (GitHub App credentials, billing). No client access.",
  "name": "AppConfig",
  "properties": {
    "callback_urls": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "configured_at": {
      "format": "date-time",
      "type": "string"
    },
    "configured_by": {
      "type": "string"
    },
    "github_app_id": {
      "type": "number"
    },
    "github_client_id": {
      "type": "string"
    },
    "github_client_secret": {
      "type": "string"
    },
    "github_html_url": {
      "type": "string"
    },
    "github_owner": {
      "type": "string"
    },
    "github_slug": {
      "type": "string"
    },
    "key": {
      "description": "Config key, e.g. github_app",
      "type": "string"
    },
    "pending_state": {
      "type": "string"
    },
    "pending_state_at": {
      "format": "date-time",
      "type": "string"
    },
    "price_amount": {
      "description": "Minor units, e.g. 850 = 8.50",
      "type": "number"
    },
    "price_currency": {
      "type": "string"
    },
    "pro_enabled": {
      "default": false,
      "description": "Handoff Pro limits switched on",
      "type": "boolean"
    },
    "pro_launched_at": {
      "description": "First time Pro was switched on (founding window starts here)",
      "format": "date-time",
      "type": "string"
    },
    "seller_enabled": {
      "default": false,
      "description": "Seller licence required to sell or license",
      "type": "boolean"
    },
    "seller_launched_at": {
      "description": "First time seller licences were switched on (founding window starts here)",
      "format": "date-time",
      "type": "string"
    },
    "seller_livemode": {
      "type": "boolean"
    },
    "seller_price_amount": {
      "description": "Minor units, e.g. 5000 = 50.00",
      "type": "number"
    },
    "seller_price_id": {
      "type": "string"
    },
    "seller_product_id": {
      "type": "string"
    },
    "stripe_livemode": {
      "type": "boolean"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "stripe_product_id": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": false,
    "delete": false,
    "read": false,
    "update": false
  },
  "type": "object"
}
{
  "name": "AppConfig",
  "type": "object",
  "description": "Server-only app settings (GitHub App credentials, billing). No client access.",
  "properties": {
    "key": {
      "type": "string",
      "description": "Config key, e.g. github_app"
    },
    "github_app_id": {
      "type": "number"
    },
    "github_slug": {
      "type": "string"
    },
    "github_client_id": {
      "type": "string"
    },
    "github_client_secret": {
      "type": "string"
    },
    "github_html_url": {
      "type": "string"
    },
    "github_owner": {
      "type": "string"
    },
    "callback_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_state": {
      "type": "string"
    },
    "pending_state_at": {
      "type": "string",
      "format": "date-time"
    },
    "configured_by": {
      "type": "string"
    },
    "configured_at": {
      "type": "string",
      "format": "date-time"
    },
    "pro_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Handoff Pro limits switched on"
    },
    "pro_launched_at": {
      "type": "string",
      "format": "date-time",
      "description": "First time Pro was switched on (founding window starts here)"
    },
    "stripe_product_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "stripe_livemode": {
      "type": "boolean"
    },
    "price_amount": {
      "type": "number",
      "description": "Minor units, e.g. 850 = 8.50"
    },
    "price_currency": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}

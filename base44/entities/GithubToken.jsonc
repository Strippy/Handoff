{
  "name": "GithubToken",
  "type": "object",
  "description": "Server-only GitHub user tokens. No client access.",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "github_id": {
      "type": "number"
    },
    "github_login": {
      "type": "string"
    },
    "access_token": {
      "type": "string"
    },
    "refresh_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "refresh_expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}

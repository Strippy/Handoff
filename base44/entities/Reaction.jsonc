{
  "name": "Reaction",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "love",
        "great_idea",
        "could_finish"
      ]
    }
  },
  "required": [
    "listing_id",
    "user_id",
    "type"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}

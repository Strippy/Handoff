{
  "name": "SavedListing",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "listing_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "listing_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}

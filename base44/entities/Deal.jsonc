{
  "name": "Deal",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "listing_title": {
      "type": "string"
    },
    "listing_cover": {
      "type": "string"
    },
    "offer_id": {
      "type": "string"
    },
    "deal_type": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "escrow_url": {
      "type": "string"
    },
    "escrow_set": {
      "type": "boolean",
      "default": false
    },
    "code_transfer": {
      "type": "boolean",
      "default": false
    },
    "asset_transfer": {
      "type": "boolean",
      "default": false
    },
    "buyer_confirmed": {
      "type": "boolean",
      "default": false
    },
    "sold": {
      "type": "boolean",
      "default": false
    },
    "handover_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "completed",
        "cancelled"
      ],
      "default": "open"
    }
  },
  "required": [
    "listing_id",
    "buyer_id",
    "seller_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

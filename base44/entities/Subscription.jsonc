{
  "description": "Server-only Stripe subscription state per user and plan. No client access; read through the billing function.",
  "name": "Subscription",
  "properties": {
    "cancel_at_period_end": {
      "type": "boolean"
    },
    "checked_at": {
      "format": "date-time",
      "type": "string"
    },
    "current_period_end": {
      "format": "date-time",
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "livemode": {
      "type": "boolean"
    },
    "plan": {
      "default": "pro",
      "description": "pro = Handoff Pro, seller = seller licence",
      "enum": [
        "pro",
        "seller"
      ],
      "type": "string"
    },
    "status": {
      "description": "Stripe subscription status",
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": false,
    "delete": false,
    "read": false,
    "update": false
  },
  "type": "object"
}
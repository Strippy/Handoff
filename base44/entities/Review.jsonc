{
  "name": "Review",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string"
    },
    "listing_id": {
      "type": "string"
    },
    "listing_title": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_avatar": {
      "type": "string"
    },
    "reviewer_role": {
      "type": "string",
      "enum": [
        "buyer",
        "seller"
      ]
    },
    "reviewee_id": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "body": {
      "type": "string"
    }
  },
  "required": [
    "deal_id",
    "reviewer_id",
    "reviewee_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
